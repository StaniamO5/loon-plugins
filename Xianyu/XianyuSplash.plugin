#!name=闲鱼去开屏广告
#!desc=改写闲鱼自家开屏接口（清空素材、次数归零、关闭开关），并拦截第三方广告联盟兜底开屏。首次启用后建议杀掉后台重开两三次。
#!author=Stan
#!homepage=https://github.com/StaniamO5/loon-plugins
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Xianyu.png
#!tag=去广告
#!system=iOS,iPadOS
#!loon_version=3.2.1(733)

[Rule]
# 让 App 放弃 SPDY/长连接、回落到普通 HTTPS，MitM 才能看到 mtop 请求
DOMAIN,amdc.m.taobao.com,REJECT
# 第三方广告联盟兜底开屏（梵蒂/倍孜）
DOMAIN,ssp.iytcdn.com,REJECT
DOMAIN,bid.ad-scope.com.cn,REJECT
DOMAIN,sdk.beizi.biz,REJECT

[Script]
# 自家开屏：素材、异步素材、开屏配置
http-response ^https:\/\/(g-)?acs\.m\.(goofish|taobao)\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.(ads|async\.ads|config)\/ script-path=https://raw.githubusercontent.com/StaniamO5/loon-plugins/main/Xianyu/XianyuSplash.js, requires-body=true, timeout=10, tag=闲鱼开屏去广告

[MITM]
hostname = acs.m.goofish.com, g-acs.m.goofish.com, acs.m.taobao.com
