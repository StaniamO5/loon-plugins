#!name=哔哩哔哩去广告
#!desc=去除 B 站 App 开屏广告（普通、品牌、活动开屏）、首页推荐的横幅与信息流广告卡，以及视频详情页（播放器下方推广卡、相关推荐广告）和评论区顶部广告。视频页与评论区的 gRPC 处理引用 Maasea/sgmodule 的 Bilibili Helper 脚本。需在 Loon 中开启 MitM over HTTP/2。首次启用后建议清除 App 缓存或重装一次。
#!author=Stan
#!homepage=https://github.com/StaniamO5/loon-plugins
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/bilibili.png
#!tag=去广告
#!system=iOS,iPadOS
#!loon_version=3.2.1(733)

[Rule]
# gRPC 接口若走 HTTP/3（QUIC），MitM 解密不了；拒绝后回落到 HTTP/2
AND,((DOMAIN,grpc.biliapi.net),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,app.bilibili.com),(PROTOCOL,QUIC)),REJECT

[Script]
# 开屏素材预下载(list)、展示策略(show)、品牌开屏(brand/list)、活动开屏(event/list2)
http-response ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(list|show|brand\/list|event\/list2) script-path=https://raw.githubusercontent.com/StaniamO5/loon-plugins/main/Bilibili/BiliSplash.js, requires-body=true, timeout=10, tag=B站开屏去广告

# 首页推荐：横幅轮播广告、信息流广告卡
http-response ^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\? script-path=https://raw.githubusercontent.com/StaniamO5/loon-plugins/main/Bilibili/BiliFeed.js, requires-body=true, timeout=10, tag=B站首页去广告
# 视频详情页（新旧两套接口 view / viewunite）、评论区列表：protobuf 二进制，引用 Maasea 的 Bilibili Helper 脚本
# 来源：https://github.com/Maasea/sgmodule （致谢 @BiliUniverse、SocialSisterYi/bilibili-API-collect）
http-response ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(view|viewunite)\.v1\.View\/(View|ViewProgress)$ script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Bilibili/bilibili.helper.js, requires-body=true, binary-body-mode=true, timeout=10, tag=B站视频页去广告
http-response ^https:\/\/grpc\.biliapi\.net\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Bilibili/bilibili.helper.js, requires-body=true, binary-body-mode=true, timeout=10, tag=B站评论区去广告

[MITM]
hostname = app.bilibili.com, grpc.biliapi.net
