#!name=虎扑去广告
#!desc=去除虎扑 App 开屏广告、下拉刷新广告、信息流与热榜中的广告卡、轮播广告位。
#!author=Stan
#!homepage=https://github.com/StaniamO5/loon-plugins
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hupu.png
#!tag=去广告
#!system=iOS,iPadOS
#!loon_version=3.2.1(733)

[Rewrite]
# 赛事页位置轮播广告
^https:\/\/games\.mobileapi\.hupu\.com\/\d+\/[\d.]+\/bplapi\/banner\/getLocationBanners reject-dict
# 图集推广模块
^https:\/\/fairy\.mobileapi\.hupu\.com\/gallery\/getmod2 reject-dict

[Script]
# 调试页：Safari 打开 https://goblin.hupu.com/loon-dump 查看抓到的开屏原始响应
http-request ^https:\/\/goblin\.hupu\.com\/loon-dump script-path=https://raw.githubusercontent.com/StaniamO5/loon-plugins/main/Hupu/HupuDump.js, timeout=10, tag=虎扑开屏抓包查看
# 广告平台全部接口（开屏、下拉刷新、信息流广告位，含 getOther/batch）：保留成功结构、掏空内容，避免白屏等待超时
http-response ^https:\/\/goblin\.hupu\.com\/[^?]*interfaceAd\/ script-path=https://raw.githubusercontent.com/StaniamO5/loon-plugins/main/Hupu/HupuSplash.js, requires-body=true, timeout=10, tag=虎扑开屏去广告
# 首页/步行街信息流、热榜、我的页、轮播：只删带广告标记的条目
http-response ^https:\/\/bbs\.mobileapi\.hupu\.com\/\d+\/[\d.]+\/bbsallapi\/lego\/data script-path=https://raw.githubusercontent.com/StaniamO5/loon-plugins/main/Hupu/HupuAds.js, requires-body=true, timeout=10, tag=虎扑信息流去广告
http-response ^https:\/\/games\.mobileapi\.hupu\.com\/\d+\/[\d.]+\/buffer\/hotList script-path=https://raw.githubusercontent.com/StaniamO5/loon-plugins/main/Hupu/HupuAds.js, requires-body=true, timeout=10, tag=虎扑热榜去广告
http-response ^https:\/\/games\.mobileapi\.hupu\.com\/\d+\/[\d.]+\/bplapi\/user\/v1\/more script-path=https://raw.githubusercontent.com/StaniamO5/loon-plugins/main/Hupu/HupuAds.js, requires-body=true, timeout=10, tag=虎扑我的页去广告
http-response ^https:\/\/fairy\.mobileapi\.hupu\.com\/mang\/preview\/banners script-path=https://raw.githubusercontent.com/StaniamO5/loon-plugins/main/Hupu/HupuAds.js, requires-body=true, timeout=10, tag=虎扑轮播去广告
# 【临时调试】记录 *.hupu.com 所有接口的路径和响应开头（不改写），定位开屏配置后删除
http-response ^https:\/\/[\w.-]+\.hupu\.com\/(?!loon-dump) script-path=https://raw.githubusercontent.com/StaniamO5/loon-plugins/main/Hupu/HupuSplash.js, requires-body=true, timeout=10, tag=虎扑抓包记录

[MITM]
hostname = goblin.hupu.com, games.mobileapi.hupu.com, bbs.mobileapi.hupu.com, fairy.mobileapi.hupu.com, *.hupu.com
